# CineForge environment flags
# Copy this file to .env and adjust values for your machine.

# TTS offline mode: when true, only LOCAL/LOCAL_GPU TTS tools are used.
# API-backed TTS (ElevenLabs, Google, Azure, etc.) are disabled.
TTS_OFFLINE=true

# Preferred TTS model tool name (must match a registered tool 'name' field).
# The PC config checker will prefer this model if the PC supports it.
PREFERRED_TTS_MODEL=indicf5_tts

# Local video model mode: when true, only LOCAL/LOCAL_GPU video tools are used.
# Cloud video providers (Wan API, Kling, Runway, etc.) are disabled.
LOCAL_VIDEO_MODEL=true

# Preferred video model tool name.
PREFERRED_VIDEO_MODEL=wan21_video
